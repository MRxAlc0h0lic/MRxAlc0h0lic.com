        .neon-box { box-shadow: 0 0 15px rgba(250,204,21,0.15); border: 1px solid rgba(250,204,21,0.3); }
        .neon-box:hover { box-shadow: 0 0 25px rgba(250,204,21,0.35); border-color: rgba(250,204,21,0.8); }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #09090b; }
        ::-webkit-scrollbar-thumb { background: #27272a; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #FACC15; }
