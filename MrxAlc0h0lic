</head>
<body class="bg-darkBg text-zinc-100 min-h-screen relative overflow-x-hidden">
    <canvas id="matrix-canvas" class="fixed inset-0 pointer-events-none z-0 opacity-20"></canvas>
    
    <header class="sticky top-0 z-50 backdrop-blur-md bg-darkBg/80 border-b border-zinc-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-lg bg-neon/10 border border-neon/50 flex items-center justify-center text-neon font-bold font-mono text-lg shadow-[0_0_10px_rgba(250,204,21,0.3)]">YA</div>
                <div><span class="font-bold text-lg tracking-wider text-white">Youssef Ahmed</span><span class="block text-xs font-mono text-neon">@MRxAlcoholic</span></div>
            </div>
            <nav class="hidden md:flex items-center space-x-6 text-sm font-medium">
                <a href="#about" class="hover:text-neon transition">About</a>
                <a href="#terminal" class="hover:text-neon transition">Terminal</a>
                <a href="#skills" class="hover:text-neon transition">Skills</a>
                <a href="#experience" class="hover:text-neon transition">Experience</a>
                <a href="#arcade" class="hover:text-neon transition text-neon flex items-center gap-1 font-bold"><i class="fa-solid fa-gamepad"></i> Arcade</a>
